[Unit]
Description=Expand root filesystem to fill the disk (ImageSmith)
DefaultDependencies=no
After=local-fs.target
Before=multi-user.target
ConditionPathExists=/usr/local/sbin/imagesmith-expand-rootfs

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/imagesmith-expand-rootfs
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
